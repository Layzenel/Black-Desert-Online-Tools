    <string name="slots_help_controls">Controls</string>
    <string name="slots_help_legend">Legend</string>
    <string name="slots_help_item">%1$d. %2$s</string>
    <string-array name="slots_help_items">
        <item>Click an element or chat window to select it, Ctrl+click to add it to or remove it from the selection.</item>
        <item>Hold the left mouse button on an empty spot to draw a frame around elements and chat windows, with Ctrl to add to the selection.</item>
        <item>Dragging an element or chat window moves everything selected together.</item>
        <item>The handle in the top-right corner of a chat window resizes it. The exact position and size of the selected window are in the sidebar.</item>
        <item>Arrow keys move the selection by 1 UI px, with Shift by the snap step.</item>
        <item>Esc or a click on an empty spot clears the selection.</item>
        <item>Right-click opens a menu: align, distribute, note under a slot.</item>
        <item>Mouse wheel zooms the canvas.</item>
        <item>Shift or Space + left mouse button, or the middle mouse button, pans the canvas.</item>
        <item>The eye in the frame hides or shows the element in game.</item>
        <item>Ctrl+Z undoes, Ctrl+Shift+Z or Ctrl+Y redoes.</item>
    </string-array>
    <string-array name="slots_help_skill_items">
        <item>Double-click a cooldown slot to pick a skill. Right-click it to add, replace or remove a skill, or edit the label under the slot.</item>
        <item>Shift + drag a skill onto another cooldown slot to swap the skills (when at most one slot is selected).</item>
        <item>Hover a skill to see its name, hold Alt for the full in-game description.</item>
        <item>In the skill picker: hover an icon, or hold Alt and hover a row, to see the skill description.</item>
    </string-array>

