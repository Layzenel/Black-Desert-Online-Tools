<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Empty screen -->
    <string name="screenshots_intro_title">Screenshot editor</string>
    <string name="screenshots_intro_description">The original stays untouched: edits are saved to a copy.</string>
    <string name="screenshots_intro_crop">Crop, including 16:9, 1:1 and 9:16</string>
    <string name="screenshots_intro_pixelate">Pixelate names, family, guild and chat</string>
    <string name="screenshots_intro_marks">Arrows, frames, brush and captions</string>
    <string name="screenshots_intro_export">Save a PNG or JPG copy, downscaled if needed, or copy it to the clipboard</string>

    <!-- Files -->
    <string name="screenshots_open">Open</string>
    <string name="screenshots_open_tooltip">Choose a screenshot, usually from Documents\\Black Desert\\ScreenShot</string>
    <string name="screenshots_copy">Copy</string>
    <string name="screenshots_copy_tooltip">Copy the edited picture to the clipboard to paste it into Discord or a chat</string>
    <string name="screenshots_save">Save copy</string>
    <string name="screenshots_save_tooltip_desktop">Save the edited picture to Black Desert\\BDO Tools\\screenshotEditor; the original stays untouched</string>
    <string name="screenshots_portraits">Use as portrait background</string>
    <string name="screenshots_portraits_tooltip">Open the edited picture in the Portrait Constructor and cut it into all portraits</string>
    <string name="screenshots_close_title">Close the screenshot?</string>
    <string name="screenshots_close_text">There are unsaved edits: closing the screenshot loses them.</string>
    <string name="screenshots_close_discard">Close without saving</string>
    <string name="screenshots_close_discard_tooltip">Close the screenshot and lose the edits</string>
    <string name="screenshots_close_cancel">Cancel</string>
    <string name="screenshots_close_cancel_tooltip">Stay in the editor</string>
    <string name="screenshots_save_tooltip_web">Download the edited picture to the browser's downloads; the original stays untouched</string>

    <!-- Editing -->
    <string name="screenshots_undo">Undo (Ctrl+Z)</string>
    <string name="screenshots_redo">Redo (Ctrl+Y)</string>
    <string name="screenshots_tool_crop">Crop</string>
    <string name="screenshots_tool_crop_hint">Drag over the area that should stay and click the green check mark. Right click, a click outside or Esc cancels the crop.</string>
    <string name="screenshots_tool_pixelate">Hide</string>
    <string name="screenshots_tool_pixelate_hint">Select a nickname, family, guild or chat: the area becomes pixelated or blurred.</string>
    <string name="screenshots_tool_arrow">Arrow</string>
    <string name="screenshots_tool_arrow_hint">Drag from the start of the arrow to its tip. Pick the arrow type from the list that opens on hover.</string>
    <string name="screenshots_tool_frame">Frame</string>
    <string name="screenshots_tool_frame_hint">Circle what matters. Pick the shape from the list that opens when you hover the frame.</string>
    <string name="screenshots_tool_brush">Brush</string>
    <string name="screenshots_tool_brush_hint">Draw while holding the mouse button.</string>
    <string name="screenshots_tool_text">Text</string>
    <string name="screenshots_tool_text_hint">Click the screenshot where the caption should start and type it. Enter to finish, Esc to cancel. Double-click a caption to edit it.</string>
    <string name="screenshots_tool_counter">Number</string>
    <string name="screenshots_tool_counter_hint">Click the screenshot in the order of the steps: each click places a circle with the next number.</string>
    <string name="screenshots_no_tool">No tool selected</string>
    <string name="screenshots_no_tool_hint">Pick a tool in the bar above the screenshot or with a right click on it. Without a tool, a click only selects and moves marks.</string>
